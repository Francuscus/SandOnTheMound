# ============================================
# SAND ON THE MOUND - LISTENER CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# --- YOUR PLAYER ---
PLAYER_FIRST_NAME=Chris
PLAYER_LAST_NAME=Sand
PLAYER_JERSEY_NUMBER=44
PLAYER_TEAM=Rutgers
# Nicknames the announcer might use (comma-separated, leave blank if none)
PLAYER_NICKNAMES=

# --- YOUR PHONE (where texts go) ---
YOUR_PHONE_NUMBER=+1XXXXXXXXXX

# --- TWILIO (sends the text messages) ---
# Sign up free at https://www.twilio.com/try-twilio
# You get a free trial with enough credits for hundreds of texts
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- WHISPER (local, FREE - runs on your PC) ---
# Path to the whisper.cpp executable (main.exe)
WHISPER_EXECUTABLE_PATH=C:\whisper\main.exe
# Path to the downloaded model file
WHISPER_MODEL_PATH=C:\whisper\models\ggml-base.en.bin

# --- FLOCOLLEGE LOGIN ---
# Your existing FloCollege/FloSports account
FLOCOLLEGE_EMAIL=your_flocollege_email
FLOCOLLEGE_PASSWORD=your_flocollege_password

# --- ADVANCED SETTINGS (you can leave these alone) ---
# How many seconds of audio per chunk (default 30)
AUDIO_CHUNK_SECONDS=30
# Minimum minutes between texts for same player (don't spam yourself)
ALERT_COOLDOWN_MINUTES=5
# Audio device name (VB-Cable output - don't change unless you renamed it)
AUDIO_DEVICE_NAME=CABLE Output (VB-Audio Virtual Cable)
